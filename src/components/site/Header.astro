---
// ABOUTME: Site header — wordmark + restrained nav + theme toggle.
// ABOUTME: Nav surfaces Writing / Talks / CV / About so all three audiences land in one click.

import ThemeToggle from './ThemeToggle.astro';
import Sigil from '../marks/Sigil.astro';

interface Props {
  /** When set, that nav item gets aria-current="page". */
  current?: 'home' | 'writing' | 'til' | 'talks' | 'portfolio' | 'library' | 'cv' | 'about';
}

const { current } = Astro.props;

const nav = [
  { id: 'writing', label: 'Writing', href: '/blog/' },
  { id: 'til', label: 'TIL', href: '/til/' },
  { id: 'talks', label: 'Talks', href: '/talks/' },
  { id: 'portfolio', label: 'Portfolio', href: '/portfolio/' },
  { id: 'library', label: 'Library', href: '/library/' },
  { id: 'cv', label: 'CV', href: '/cv/' },
  { id: 'about', label: 'About', href: '/about/' },
] as const;
---

<div class="site-header-wrap">
  <header class="site-header">
    <a
      class="site-mark"
      href="/"
      aria-label="Esteban Torres — home"
      data-current={current === 'home'}
    >
      <span class="site-mark__name">Esteban Torres</span>
      <span class="site-mark__sigil" aria-hidden="true">
        <Sigil size="0.7em" />
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.id ? 'page' : undefined}
                class={current === item.id ? 'is-current' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </header>
</div>

<script>
  // On phones the nav is a horizontal scroll strip. When the page you're on
  // sits past its visible edge, the "you are here" marker is hidden until you
  // swipe — so centre the current item on load. Measured off bounding rects
  // rather than offsetLeft, which would need a positioned ancestor to be
  // meaningful. Writes scrollLeft only, so the page itself never moves; a no-op
  // on viewports where the row already fits and there's nothing to scroll.
  const nav = document.querySelector('.site-nav');
  const current = nav?.querySelector('.is-current');

  if (nav && current) {
    const navBox = nav.getBoundingClientRect();
    const itemBox = current.getBoundingClientRect();
    nav.scrollLeft += itemBox.left - navBox.left - (navBox.width - itemBox.width) / 2;
  }
</script>

<style>
  /* Sticky wrapper — full viewport width so the blurred bg covers content on
     either side of the centered header even on wide viewports. */
  .site-header-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 84%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  /* Browsers without backdrop-filter (older Firefox, some Android) get a
     more opaque bg so content underneath doesn't bleed through unreadably. */
  @supports not (backdrop-filter: blur(1px)) {
    .site-header-wrap {
      background: var(--bg);
    }
  }

  .site-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--gutter);
    max-width: var(--max-content);
    width: 100%;
    margin: 0 auto;
  }

  .site-mark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }

  .site-mark__name {
    line-height: 1;
  }

  .site-mark__sigil {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    /* Sigil inherits this via currentColor in the SVG fill/stroke. */
    color: var(--accent);
    transform: translateY(-0.05em);
    transform-origin: center;
    transition: transform var(--duration-fast) var(--ease-out-quart);
  }

  /* On the page that the site-mark points at, lift the sigil slightly
     so the "you are here" signal matches `.site-nav a.is-current`. */
  .site-mark[data-current='true'] .site-mark__sigil {
    transform: translateY(-0.05em) scale(1.35);
  }

  .site-nav ul {
    display: flex;
    gap: clamp(var(--space-md), 3vw, var(--space-lg));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    color: var(--ink-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 0.25rem 0;
    border-bottom: 1px solid transparent;
    transition:
      color var(--duration-fast) var(--ease-out-quart),
      border-color var(--duration-fast) var(--ease-out-quart);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
  }

  .site-nav a.is-current {
    color: var(--ink);
    border-color: var(--accent);
  }

  /* 720px is where the one-row header stops fitting: wordmark + the seven nav
     items + toggle need ~658px of content box, and below this the flex row
     starts compressing the labels — at phone widths it squeezed the theme
     toggle clean off the screen. Under it, the nav drops to its own row. */
  @media (max-width: 720px) {
    .site-header {
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    /* Seven items don't fit across a phone, so the row scrolls rather than
       clipping whatever falls past the edge. It bleeds out to the viewport
       edges — a strip that runs edge-to-edge reads as scrollable, where one
       stopping short of the margin reads as cut off. */
    .site-nav {
      order: 3;
      width: calc(100% + var(--gutter) * 2);
      margin-inline: calc(var(--gutter) * -1);
      /* Bottom padding is for the focus ring (2px outline, 3px offset), which
         the scroll container would otherwise clip. */
      padding-block: var(--space-sm) var(--space-xs);
      border-top: 1px solid var(--rule);
      overflow-x: auto;
      /* Don't hand the swipe to the page once the row hits its end. */
      overscroll-behavior-x: contain;
      /* The item cut off at the edge is the affordance; a scrollbar here would
         sit under the labels and add noise to a deliberately quiet header. */
      scrollbar-width: none;
    }

    .site-nav::-webkit-scrollbar {
      display: none;
    }

    /* The gutter lives on the list, not on the scroll container: a scroller's
       trailing padding is left out of its scroll extent, so putting it on
       .site-nav would leave the last item flush against the screen edge at
       full scroll. Sizing the list to max-content makes the padding part of
       the scrolled box, which gives both ends a real gutter. */
    .site-nav ul {
      justify-content: flex-start;
      width: max-content;
      padding-inline: var(--gutter);
    }

    /* Without this the labels compress toward min-content instead of
       overflowing into the scroll. */
    .site-nav li {
      flex: 0 0 auto;
    }
  }
</style>
