---
// ABOUTME: Homepage. Stack: Hero → CuratedPicks ("What I'd point you at right now") → LatestWriting → CurrentlyReading.
// ABOUTME: Reading depth is the north star; the page exists to surface the post the reader clicks first AND the one they click second.

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import CuratedPicks from '../components/home/CuratedPicks.astro';
import LatestWriting from '../components/home/LatestWriting.astro';
import CurrentlyReading from '../components/home/CurrentlyReading.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);

const latest = allPosts.slice(0, 10);

// Curated picks — handpicked, voice-framed, refreshed when something better lands.
// Slugs are the entry ids from src/content/blog (filename without .mdx).
const picks = [
  {
    slug: '2026-02-a-gsd-system-for-claude-code',
    framing: 'If you’re new here',
  },
  {
    slug: '2022-03-manager-weekly-newsletter',
    framing: 'If you manage people',
  },
  {
    slug: '2020-05-career-change',
    framing: 'The one I’m proudest of',
  },
];

const now =
  "Read a teardown of the answer-engine playbook that got Gamma to $100M: 'LLMs never cite praise, only comparisons; a citation rots in about three months; and right now the models can't tell Forbes from a no-name blog.' All true, all useful. Also I was given a post by Zbigniew Herbert in the other ear, insisting that refusal “didn't require great character at all… fundamentally it was a matter of taste.” So: still writing in the open, on a domain I own, and letting the citation math land where it lands.";

const updated = 'August 2026';
---

<BaseLayout current="home">
  <Hero />
  <CuratedPicks now={now} updated={updated} picks={picks} />
  <LatestWriting posts={latest} totalCount={allPosts.length} />
  <CurrentlyReading />
</BaseLayout>
